# Only what the image needs (#383). data/ is out except the committed reference tables and aliases:
# no SQLite files, caches, CCRS/TASAS downloads, NAD or TIGER copies, and no .env or keys.
**
!Dockerfile
!backend/
!frontend/
!data/reference/
!data/aliases/
**/__pycache__
**/*.pyc
**/.env
**/*.sqlite*
frontend/node_modules
frontend/dist
